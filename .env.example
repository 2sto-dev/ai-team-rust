# Copy to .env (never committed). Only needed for providers that use an API key:
# the contract's model block names the variable in `api_key_env`.

# Claude (provider: claude) reads this by default:
ANTHROPIC_API_KEY=

# OpenAI or a compatible server (provider: openai), e.g. api_key_env: OPENAI_API_KEY
OPENAI_API_KEY=

# Ollama (provider: ollama) needs no key.

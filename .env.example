# ============================================================================
# AI Team - cheile API (tokenii de acces la furnizori)
#
# Copiaza fisierul asta ca .env si pune cheile acolo (.env NU intra in git). Se citeste automat la pornirea
# oricarei comenzi ai-team (console, web, request, doctor...), din folderul
# C:\dev\ai-team-rust. Dupa o modificare, reporneste `cargo run -- web`.
#
# Ce angajat foloseste ce furnizor se alege in contractul lui:
#   company/employees/<ID>/contract.yaml  ->  blocul `model:`
# Verificare: `cargo run -- doctor` spune daca lipseste o cheie ceruta.
# ============================================================================

# --- Anthropic (Claude) ------------------------------------------------------
# Pentru angajatii cu `provider: claude`. Cheia: https://console.anthropic.com
ANTHROPIC_API_KEY=

# --- OpenAI (sau server compatibil OpenAI) -----------------------------------
# Pentru angajatii cu `provider: openai` si `api_key_env: OPENAI_API_KEY`.
OPENAI_API_KEY=

# --- Workspace Anthropic (doar daca cheia NU e legata de un workspace) ------
# ID-ul din console.anthropic.com -> Settings -> Workspaces. Mai simplu: o cheie creata
# direct intr-un workspace, caz in care lasi gol.
ANTHROPIC_WORKSPACE_ID=

# --- Ollama ------------------------------------------------------------------
# Nu are nevoie de cheie (serverul de pe 10.10.0.14 e in retea locala).
